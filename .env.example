# OpenClaw Portable Environment Configuration
# All variables are optional with built-in fallbacks.

# Master console login password (default: openclaw2025)
OPENCLAW_PASSWORD=openclaw2025

# Storage file path (default: ./openclaw_store.json)
DATA_FILE_PATH=

# Secret token required for worker check-in/polling (optional)
WORKER_SECRET_TOKEN=

# Default model & agent
DEFAULT_MODEL=qwen3:14b-q4_K_M
DEFAULT_AGENT=kaggle-strategist

# Optional Direct Upstream Inference Providers:
# Set OLLAMA_BASE_URL to connect directly to local/remote Ollama (e.g., http://localhost:11434)
OLLAMA_BASE_URL=

# Set OPENAI_COMPATIBLE_URL to connect to vLLM, Groq, Together, DeepSeek, etc.
OPENAI_COMPATIBLE_URL=
OPENAI_API_KEY=

# Set AGENT_WEBHOOK_URL to forward prompts to a custom webhook
AGENT_WEBHOOK_URL=

# Frontend Vite configuration:
# Override target API base URL at build time (e.g. https://your-domain.com/namecheap/api.php)
VITE_API_BASE_URL=

